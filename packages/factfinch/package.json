{
  "name": "factfinch",
  "version": "0.2.0",
  "description": "Plain-language interview engine: describe rules as data, ask only the questions still needed, explain every result. Inspired by the IRS Direct File Fact Graph.",
  "license": "Apache-2.0",
  "author": "lobojoel2003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobojoel2003/Factfinch.git",
    "directory": "packages/factfinch"
  },
  "homepage": "https://github.com/lobojoel2003/Factfinch#readme",
  "bugs": "https://github.com/lobojoel2003/Factfinch/issues",
  "keywords": [
    "rules-engine",
    "fact-graph",
    "interview",
    "eligibility",
    "eitc",
    "child-tax-credit",
    "benefits",
    "explainable",
    "direct-file"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "factfinch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rules/*": "./rules/*",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "rules",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "tsup": "^8.5.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
